# Set one key for real analysis. With no key the app runs in demo mode with sample meals.

# Google Gemini: free tier with rate limits. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model override (default: gemini-flash-latest).
GEMINI_MODEL=

# Claude: paid per use. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional model override, e.g. claude-sonnet-5-5 for lower cost (default: claude-opus-5-5).
ANTHROPIC_MODEL=

# When both keys are set, pick one: claude or gemini (default: claude).
AI_PROVIDER=
# Set to true to force demo results even when a key is present.
DEMO_MODE=
